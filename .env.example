# Host directory mounted into /data inside the container.
PHOTO_FOLDER=./photos

# Comma-separated container paths exposed to the dashboard folder picker.
# Any additional host folder mounted via docker-compose.yml (e.g. /media/pictures)
# must be listed here before it can be selected in the UI.
APPROVED_MEDIA_ROOTS=/data

# Preferred: provide AUTH_DATA via a Docker secret mounted at /run/secrets/gphotos_auth
# using compose.override.yaml (never commit real tokens to Git).
AUTH_DATA_FILE=/run/secrets/gphotos_auth
# AUTH_DATA=

# Safety: keep local original photos and videos untouched after upload.
DELETE_AFTER_UPLOAD=false

# Concurrent GPMC batch settings (single queue worker).
UPLOAD_THREADS=2
UPLOAD_BATCH_SIZE=4

# Upload behaviour defaults.
UPLOAD_QUALITY=original
USE_QUOTA=false
DUPLICATE_DETECTION=true
FILENAME_CONFLICT_POLICY=hash_dedup
AUTO_RETRY_FAILED=true

# File stability and scanning settings (seconds).
STABLE_SECONDS=5
STABILITY_TIMEOUT=300
SCAN_INTERVAL=60
POLL_INTERVAL=30
REQUEST_TIMEOUT=60

# Retry backoff and graceful shutdown (seconds).
MAX_ATTEMPTS=5
RETRY_BASE=5
RETRY_MAX=3600
SHUTDOWN_TIMEOUT=120

# Web dashboard settings.
# Bound to 127.0.0.1 by default; set to 0.0.0.0 only on a trusted home LAN.
DASHBOARD_ENABLED=true
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=admin
# Optional: set an initial admin password (>= 8 chars). If left blank, the dashboard
# prompts you to create your administrator password once on first visit.
DASHBOARD_PASSWORD=
# Optional: random hex secret for signing session cookies across restarts.
# If blank, a 32-byte random secret is generated and saved with 0600 permissions in /state.
DASHBOARD_SESSION_SECRET=
# Set true only when serving the dashboard over HTTPS (e.g. behind a TLS reverse proxy).
DASHBOARD_SECURE_COOKIES=false

# Optional Immich Stack (used when starting with docker-compose.immich.yml)
# Host folder where Immich stores uploaded originals (mounted read-only into Sync Manager at /media/immich).
IMMICH_UPLOAD_LOCATION=./immich-library
IMMICH_VERSION=release
IMMICH_PORT=2283
# Use alphanumeric characters only (A-Za-z0-9) for PostgreSQL password.
IMMICH_DB_PASSWORD=ChangeMeAlphanumeric123
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
TZ=Etc/UTC

LOG_LEVEL=INFO
